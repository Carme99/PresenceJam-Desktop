# Tauri
src-tauri/target/
src-tauri/target
src-tauri/.cargo/
# Cargo target dir (CARGO_TARGET_DIR override or future workspace member)
target/

# SvelteKit
build/
.svelte-kit/
# No trailing slash on purpose: `node_modules/` matches DIRECTORIES only, so a
# `node_modules` SYMLINK (e.g. a git-worktree convenience link) would stage
# silently under `git add -A` and publish an absolute path from the author's
# machine. See issue #1123.
node_modules

# Render tooling download lands at repo root (issue #753) — never commit
/chrome-headless-shell/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets / env
.env
.env.*
*.local

# Logs
*.log
logs/

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
coverage/

# Claude Code settings (local only, never commit)
.claude/

# ts-rs generated TypeScript bindings (regenerated by `cargo test`)
# See issue #78. Do NOT commit; they are derived, not source.
src/lib/types-generated/

# Worktree reports (never commit)
/REPORT.md

# Pasted screenshots land here by accident — real captures live in docs/screenshots/ (#774)
/image_0*.*
/tmp-screenshots/
