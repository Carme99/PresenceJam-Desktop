{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PresenceJam",
  "version": "4.0.0",
  "identifier": "com.presencejam.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PresenceJam",
        "label": "main",
        "width": 600,
        "height": 750,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://i.scdn.co https://mosh-pa.spotify.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.spotify.com https://login.microsoftonline.com https://graph.microsoft.com https://accounts.spotify.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "msi",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "https://timestamp.comodoca.com",
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Spotify to Teams Status Sync",
    "longDescription": "Automatically syncs your currently playing Spotify track to your Microsoft Teams status message."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "presencejam"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Carme99/PresenceJam-Desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0QzQ0MDY4REQyQjQ1NjYKUldSbVJTdmRhRURFaE5uc3FOb2xBMWQ4cy8ra1h1OTQxTHpWbitKTnYyWC83dVIxclBXb05VQXkK"
    }
  }
}
